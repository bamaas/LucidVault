# Required
OLLAMA_API_KEY=

# Optional
# RAINDROP_ACCESS_TOKEN=
# SUPADATA_API_KEY=
# OLLAMA_MODEL=qwen3.5
# POLL_INTERVAL=5m

# --- Full-stack only (sync + agents) - see docs/guides/agent-chat/ -----------
# Unused by the single-container docker-compose.yml. Needed by the full-stack
# overlay (docs/guides/agent-chat/docker-compose.agent.yml).
#
# CouchDB (Obsidian LiveSync) - credentials must match deploy/livesync-bridge/config.json
# COUCHDB_USER=admin
# COUCHDB_PASSWORD=
# COUCHDB_BIND=127.0.0.1        # set 0.0.0.0 for external LiveSync clients
#
# Shared bearer secret between OpenWebUI and the Hermes API server; MUST equal
# API_SERVER_KEY in ~/.hermes/.env. Generate once with: openssl rand -hex 24
# HERMES_API_KEY=

# Optional - expose the MCP server over HTTP, in-process with the pipeline.
# Empty (default) keeps MCP off. Set an address (e.g. :8080) to enable it.
# When enabled, also uncomment the loopback port publish in docker-compose.yml.
# MCP_HTTP_ADDR=:8080
# Host-header allowlist (DNS-rebinding guard). Default: localhost,127.0.0.1.
# Set to "*" (or empty) to disable the guard - required in Kubernetes where the
# request Host is the Service DNS name and a NetworkPolicy enforces access.
# MCP_ALLOWED_HOST=localhost,127.0.0.1
# Expose the duplicate content-read MCP tools (read_wiki, search_index, grep_vault,
# read_note, read_raw, vault_overview, get_soul). Off by default so filesystem-capable
# agents (e.g. Hermes) read the vault directly; graph and write tools stay available.
# Set true only for clients that reach the vault only over MCP (no filesystem access).
# MCP_READ_TOOLS=false

# How the generated AGENTS.md tells an agent to use its OWN web search relative to
# the curated vault. LucidVault never provides or names a search provider.
#   off            no web-search guidance at all
#   fallback       (default) only when the vault does not cover the question
#   time-sensitive also for latest/current/versions/news/prices/dates questions
#   immediately    use web search and the vault in parallel for any substantive question
# Unknown values fall back to "fallback".
# AGENT_WEB_SEARCH_STRATEGY=fallback
