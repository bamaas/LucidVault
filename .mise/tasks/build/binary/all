#!/usr/bin/env bash
set -euo pipefail
#MISE description="Build binaries for all release platforms"

mkdir -p dist
platforms=(
  "linux/amd64"
  "linux/arm64"
  "darwin/amd64"
  "darwin/arm64"
  "windows/amd64"
  "windows/arm64"
)
for platform in "${platforms[@]}"; do
  GOOS="${platform%/*}"
  GOARCH="${platform#*/}"
  output="lucidvault-${GOOS}-${GOARCH}"
  if [ "${GOOS}" = "windows" ]; then
    output="${output}.exe"
  fi
  echo "Building ${output}..."
  GOOS="${GOOS}" GOARCH="${GOARCH}" OUTPUT="dist/${output}" mise run build:binary
done
